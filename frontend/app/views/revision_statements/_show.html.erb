<%
   section_id = "revision_statement" if section_id.blank?
%>

<section id="<%= section_id %>">
  <h3><%= t("revision_statement._plural") %></h3>
  <div class="details my-3" id="<%= section_id %>_accordion">
    <% revision_statements.each_with_index do | rs, index | %>
      <div class="card mb-3">
        <div class="card-header panel-heading">
          <button class="btn btn-block accordion-toggle collapsed" data-toggle="collapse" data-parent="#<%= section_id %>_accordion" data-target="#<%= section_id %>_revision_statement_<%= index %>" aria-expanded="false" aria-controls="<%= section_id %>_revision_statement_<%= index %>">
            <div class="row">
              <div class="col-md-1">
                <span class="glyphicon"></span>
              </div>
              <div class="col-md-4">
                <%= rs['date'] %>
              </div>
              <div class="col-md-7">
                <%= rs['description'] %>
              </div>
            </div>
          </button>
        </div>
        <div id="<%= section_id %>_revision_statement_<%= index %>" class="panel-collapse collapse">
          <%= read_only_view(rs) %>
        </div>
      </div>
    <% end %>
  </div>
</section>
