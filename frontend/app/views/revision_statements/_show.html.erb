<%
   section_id = "revision_statement" if section_id.blank?
%>

<section id="<%= section_id %>">
  <h3><%= t("revision_statement._plural") %></h3>
  <div class="details my-3" id="<%= section_id %>_accordion">
    <% revision_statements.each_with_index do | rs, index | %>
      <div class="card mb-3">
        <div class="card-header panel-heading">
          <%= render :layout => "shared/accordion_header_toggle",
                :locals => { :panel_id => "#{section_id}_revision_statement_#{index}", :accordion_parent_id => "#{section_id}_accordion" } do %>
            <span class="accordion-header-toggle__cell--md-4">
              <%= rs['date'] %>
            </span>
            <span class="accordion-header-toggle__cell--md-7">
              <%= rs['description'] %>
            </span>
          <% end %>
        </div>
        <div id="<%= section_id %>_revision_statement_<%= index %>" class="panel-collapse collapse">
          <%= read_only_view(rs) %>
        </div>
      </div>
    <% end %>
  </div>
</section>
