<%
   section_id = "metadata_rights_declaration" if section_id.blank?
   section_title = "Metadata Rights Declarations" if section_title.blank?
%>

<section id="<%= section_id %>">
  <h3><%= section_title %></h3>
  <div class="details my-3" id="<%= section_id %>_accordion">
    <% metadata_rights_declarations.each_with_index do | metadata_rights_declaration, index | %>
      <% license = metadata_rights_declaration['license'] || "other" %>
      <div class="card mb-3">
        <div class="card-header panel-heading">
          <%= render :layout => "shared/accordion_header_toggle",
                :locals => { :panel_id => "#{section_id}_metadata_rights_declaration_#{index}", :accordion_parent_id => "#{section_id}_accordion" } do %>
            <span class="accordion-header-toggle__title accordion-header-toggle__cell--md-6">
              <%= t("enumerations.metadata_license.#{license}", :default => metadata_rights_declaration['rights_statement']) %>
            </span>
          <% end %>
        </div>
        <div id="<%= section_id %>_metadata_rights_declaration_<%= index %>" class="panel-collapse collapse">
          <%= render_aspace_partial :partial => "metadata_rights_declarations/show_fields", :locals => { :metadata_rights_declaration => metadata_rights_declaration } %>
        </div>
      </div>
    <% end %>
  </div>
</section>
