<%
   section_id = "agent_identifiers" if section_id.blank?
   section_title = "Entity IDs" if section_title.blank?
%>

<section id="<%= section_id %>">
  <h3><%= section_title %></h3>
  <div class="details my-3" id="<%= section_id %>_accordion">
    <% agent_identifiers.each_with_index do | agent_identifier, index | %>
      <div class="card mb-3">
        <div class="card-header panel-heading">
          <%= render :layout => "shared/accordion_header_toggle",
                :locals => { :panel_id => "#{section_id}_agent_identifier_#{index}", :accordion_parent_id => "#{section_id}_accordion" } do %>
            <span class="accordion-header-toggle__title accordion-header-toggle__cell--md-6">
              <%= agent_identifier["entity_identifier"] %>
            </span>
          <% end %>
        </div>
        <div id="<%= section_id %>_agent_identifier_<%= index %>" class="panel-collapse collapse">
          <%= read_only_view(agent_identifier) %>
        </div>
      </div>
    <% end %>
  </div>
</section>
