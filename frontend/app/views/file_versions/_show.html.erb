<%
   section_id = "file_versions" if section_id.blank?
%>

<section id="<%= section_id %>">
  <h3><%= t("file_version._plural") %></h3>
  <div class="accordion details my-3" id="<%= section_id %>_accordion">
    <% file_versions.each_with_index do | file_version, index | %>
      <div class="card border">
        <div class="panel-heading card-header">
          <%= render :layout => "shared/accordion_header_toggle",
                :locals => { :panel_id => "#{section_id}_file_version_#{index}", :accordion_parent_id => "#{section_id}_accordion" } do %>
            <span class="accordion-header-toggle__title accordion-header-toggle__cell accordion-header-toggle__cell--md-7">
              <%= file_version['file_uri'] %>
            </span>
            <span class="accordion-header-toggle__badges">
              <% if file_version['publish'] %><span class="badge badge-success pull-right" style="margin-left: 5px;"><%= t("file_version._frontend.published") %></span><% end %>
              <% if file_version['is_display_thumbnail'] %><span class="badge badge-info pull-right" style="margin-left: 5px;"><%= t("file_version.is_display_thumbnail") %></span><% end %>
              <% if file_version['is_display_link'] %><span class="badge badge-primary pull-right" style="margin-left: 5px;"><%= t("file_version.is_display_link") %></span><% end %>
            </span>
          <% end %>
        </div>
        <div id="<%= section_id %>_file_version_<%= index %>" class="accordion-body collapse">
          <div class="form-horizontal">
            <% if can_embed?(file_version) %>
              <% alt_text = file_version['caption'] ? file_version['caption'] : title %>
              <%= render_aspace_partial :partial => "file_versions/image", :locals => {:file => file_version, :alt_text => alt_text } %>
            <% end %>
            <% if IIIF.manifest?(file_version) %>
              <%= render_aspace_partial :partial => "file_versions/iiif_embed", :locals => {:manifest => file_version} %>
            <% end %>
            <%= render_aspace_partial :partial => "file_versions/file_uri", :locals => {:file_uri => uri_or_string( file_version['file_uri'] ) } %>
          </div>
          <%= read_only_view(file_version) %>
        </div>
      </div>
    <% end %>
  </div>
</section>
