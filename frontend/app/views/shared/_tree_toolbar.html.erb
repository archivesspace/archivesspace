<div
  id="tree-toolbar"
  class="tree-toolbar btn-toolbar"
  role="toolbar"
  aria-label="<%= I18n.t('tree.toolbar_aria_label') %>"
>
  <button
    type="button"
    class="btn btn-sm btn-default tree-toolbar__btn tree-toolbar__btn--reorder-toggle js-tree-toolbar-reorder-toggle"
    data-tree-action="reorder-toggle"
    data-label-enable-reorder="<%= h(I18n.t('actions.enable_reorder')) %>"
    data-label-reorder-active="<%= h(I18n.t('actions.reorder_active')) %>"
  >
    <%= I18n.t('actions.enable_reorder') %>
  </button>

  <div class="btn-group tree-toolbar__group ml-1 js-tree-toolbar-cut-paste-group" role="group" aria-label="<%= I18n.t('actions.cut_paste_group', default: 'Cut and paste') %>">
    <button
      type="button"
      class="btn btn-sm btn-default tree-toolbar__btn js-tree-toolbar-cut"
      data-tree-action="cut"
    >
      <%= I18n.t('actions.cut') %>
    </button>
    <button
      type="button"
      class="btn btn-sm btn-default tree-toolbar__btn js-tree-toolbar-paste"
      data-tree-action="paste"
    >
      <%= I18n.t('actions.paste') %>
    </button>
  </div>

  <div
    class="btn-group dropdown tree-toolbar__group ml-1 js-tree-toolbar-move-group"
    role="group"
    aria-label="<%= I18n.t('actions.move_group') %>"
    data-label-move-up-a-level="<%= h(I18n.t('actions.move_up_a_level')) %>"
    data-label-move-up="<%= h(I18n.t('actions.move_up')) %>"
    data-label-move-down="<%= h(I18n.t('actions.move_down')) %>"
    data-label-move-down-into="<%= h(I18n.t('actions.move_down_into')) %>"
  >
    <button
      type="button"
      class="btn btn-sm btn-default dropdown-toggle tree-toolbar__btn js-tree-toolbar-move-toggle"
      data-toggle="dropdown"
      aria-haspopup="true"
      aria-expanded="false"
      data-tree-action="move-menu"
    >
      <%= I18n.t('actions.move') %>
    </button>
    <ul class="dropdown-menu js-tree-toolbar-move-menu"></ul>
  </div>

  <div
    class="btn-group tree-toolbar__group ml-2 js-tree-toolbar-expand-group"
    role="group"
    aria-label="<%= I18n.t('actions.expand_collapse_group', default: 'Expand and collapse tree') %>"
  >
    <button
      type="button"
      class="btn btn-sm btn-default tree-toolbar__btn js-tree-toolbar-expand-mode"
      data-tree-action="expand-mode"
      data-label-expand-tree-mode-on="<%= h(I18n.t('actions.expand_tree_mode_on')) %>"
      data-label-expand-tree-mode-off="<%= h(I18n.t('actions.expand_tree_mode_off')) %>"
    >
      <%= I18n.t('actions.expand_tree_mode_on') %>
    </button>
    <button
      type="button"
      class="btn btn-sm btn-default tree-toolbar__btn js-tree-toolbar-collapse-tree"
      data-tree-action="collapse-tree"
    >
      <%= I18n.t('actions.collapse_tree') %>
    </button>
  </div>

  <div
    class="btn-group tree-toolbar__group ml-2 js-tree-toolbar-primary-actions"
    role="group"
    aria-label="<%= I18n.t('actions.primary_tree_actions', default: 'Primary tree actions') %>"
  >
    <button
      type="button"
      class="btn btn-sm btn-default tree-toolbar__btn js-tree-toolbar-add-child"
      data-tree-action="add-child"
    >
      <%= add_child_label %>
    </button>
    <button
      type="button"
      class="btn btn-sm btn-default tree-toolbar__btn js-tree-toolbar-add-sibling"
      data-tree-action="add-sibling"
    >
      <%= add_sibling_label %>
    </button>
    <% if show_add_duplicate %>
      <button
        type="button"
        class="btn btn-sm btn-default tree-toolbar__btn js-tree-toolbar-add-duplicate"
        data-tree-action="add-duplicate"
      >
        <%= add_duplicate_label %>
      </button>
    <% end %>
    <% if show_load_bulk %>
      <div
        class="btn-group js-tree-toolbar-load-bulk-group"
        role="group"
        aria-label="<%= I18n.t('resource._frontend.action.load_bulk') %>"
      >
        <button
          type="button"
          class="btn btn-sm btn-default tree-toolbar__btn border-right-0 js-tree-toolbar-load-bulk"
          data-tree-action="load-bulk"
        >
          <%= I18n.t('resource._frontend.action.load_bulk') %>
        </button>
        <a
          target="_blank"
          class="btn btn-sm btn-default border-left-0 has-tooltip js-tree-load-via-spreadsheet-help"
          id="load_via_spreadsheet_help_icon"
          href="<%= ArchivesSpaceHelp.url_for_topic('resource_load_via_spreadsheet') %>"
          data-toggle="tooltip"
          data-placement="auto"
          title="<%= t('help.topics.resource_load_via_spreadsheet') %>"
          data-container="body"
        >
          <span class="context-help-icon glyphicon glyphicon-question-sign"></span>
        </a>
      </div>
    <% end %>
    <% if show_rde %>
      <button
        type="button"
        class="btn btn-sm btn-default tree-toolbar__btn js-tree-toolbar-rde"
        data-tree-action="rde"
      >
        <%= I18n.t('actions.rapid_data_entry') %>
      </button>
    <% end %>
  </div>

  <a
    href="#"
    class="ml-auto btn btn-sm btn-success tree-toolbar__btn js-tree-toolbar-finish-editing"
    data-tree-action="finish-editing"
  >
    <%= I18n.t('actions.finish_editing') %>
  </a>
</div>
