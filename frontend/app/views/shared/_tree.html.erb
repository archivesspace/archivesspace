<%
   root_type = root_record.jsonmodel_type
   child_type = TreeHierarchy.child_type_for(root_type)
   show_identifiers = root_type == 'resource' && AppConfig[:display_identifiers_in_tree_container]
   read_only = false if read_only.blank?
   toolbar_capabilities = {
     show_add_duplicate: root_type == 'resource',
     show_load_bulk: root_type == 'resource',
     show_rde: %w[resource digital_object].include?(root_type),
   }
   toolbar_add_child_label = I18n.t("#{root_type}._frontend.action.add_child")
   toolbar_add_sibling_label = child_type ? I18n.t("#{child_type}._frontend.action.add_sibling") : ''
   toolbar_add_duplicate_label = I18n.t('archival_object._frontend.action.add_duplicate')
   new_child_placeholder_title = child_type ? I18n.t("#{child_type}._frontend.tree.new_record_title") : ''
   new_duplicate_placeholder_title = root_type == 'resource' ? I18n.t('archival_object._frontend.tree.duplicated_record_title') : ''
%>

<%= javascript_include_tag "TreeRouter.js" %>
<%= javascript_include_tag "TreeIds.js" %>
<%= javascript_include_tag "Tree.js" %>
<%= javascript_include_tag "TreeResizer.js" %>
<%= javascript_include_tag "TreeRecordPane.js" %>
<%= javascript_include_tag "TreeToolbar.js" %>
<%= javascript_include_tag "TreeToolbarActions.js" %>
<%= javascript_include_tag "TreeMultiSelection.js" %>
<%= javascript_include_tag "TreeDropHitbox.js" %>
<%= javascript_include_tag "TreeDragDrop.js" %>
<%= javascript_include_tag "TreeCutPaste.js" %>
<%= javascript_include_tag "TreeMove.js" %>
<%= javascript_include_tag "TreeReorderActions.js" %>

<div
  id="tree-component"
  data-batch-size="<%= Rails.configuration.tree_batch_size %>"
  data-is-read-only="<%= read_only %>"
  data-root-uri="<%= root_record.uri %>"
  data-record-type="<%= root_type %>"
  data-child-type="<%= child_type %>"
  data-new-child-placeholder-title="<%= new_child_placeholder_title %>"
  data-new-duplicate-placeholder-title="<%= new_duplicate_placeholder_title %>"
  data-label-drag-to-reorder="<%= h(I18n.t('tree.drag_to_reorder')) %>"
  data-error-move-records="<%= h(I18n.t('tree.errors.move_records')) %>"
  data-error-move-records-message="<%= h(I18n.t('tree.errors.move_records_message')) %>"
>
  <% if !read_only %>
    <%= render_aspace_partial :partial => "shared/tree_toolbar", :locals => {
         :add_child_label => toolbar_add_child_label,
         :add_sibling_label => toolbar_add_sibling_label,
         :add_duplicate_label => toolbar_add_duplicate_label,
         :show_add_duplicate => toolbar_capabilities[:show_add_duplicate],
         :show_load_bulk => toolbar_capabilities[:show_load_bulk],
         :show_rde => toolbar_capabilities[:show_rde],
       } %>
  <% end %>
  <div id="tree-container" class="mb-2"></div>
  <%= render_aspace_partial :partial => "shared/tree_resizer" %>
  <%= render_aspace_partial :partial => "shared/tree_record_pane" %>
</div>

<%= render_aspace_partial partial: 'shared/tree_templates', locals: { root_type: root_type, show_identifiers: show_identifiers } %>

<template id="tree-empty-drag-image-template">
  <div class="tree-empty-drag-image"></div>
</template>

<template id="tree-drag-preview-template">
  <div class="tree-drag-preview">
    <ol class="tree-drag-preview__list"></ol>
  </div>
</template>

<template id="tree-drag-preview-item-template">
  <li class="tree-drag-preview__item"></li>
</template>

<template id="tree-drag-preview-count-template">
  <div class="tree-drag-preview__count"></div>
</template>

<%
  # ANW-2322 Temporarily copy and adapt ENUMERATION_TRANSLATIONS from largetree.js
  # for use in a .js file (not .js.erb)
  translations = {}

  ['instance_instance_type', 'container_type', 'resource_resource_type',
    'archival_record_level', 'digital_object_digital_object_type'
  ].each do |enumeration_name|
    translations[enumeration_name] ||= {}

    JSONModel.enum_values(enumeration_name).each do |enumeration_value|
      translations[enumeration_name][enumeration_value] = t("enumerations.#{enumeration_name}.#{enumeration_value}", :default => enumeration_value)
    end
  end
%>

<script>
window.TreeHierarchyConfig = <%== TreeHierarchy.to_json %>;

const ENUMERATION_TRANSLATIONS_2 = <%== translations.to_json %>;

const EnumerationTranslations2 = {
  t : function(enumeration, enumeration_value) {
    if (ENUMERATION_TRANSLATIONS_2.hasOwnProperty(enumeration)) {
        if (ENUMERATION_TRANSLATIONS_2[enumeration].hasOwnProperty(enumeration_value)) {
            return ENUMERATION_TRANSLATIONS_2[enumeration][enumeration_value];
        } else if (enumeration == 'archival_record_level'){
            return enumeration_value;
        }
    }
    return null;
  },
  ENUMERATION_TRANSLATIONS: ENUMERATION_TRANSLATIONS_2
};

const tree = new Tree({
  sep: "<%= I18n.t("#{root_type}.identifier_separator") %>",
  bulk: "<%= I18n.t("date_type_bulk.bulk") %>",
  expand: <%== I18n.t('actions.expand_node').to_json %>,
  collapse: <%== I18n.t('actions.collapse_node').to_json %>,
  enumerations: EnumerationTranslations2
});

const treeRecordPane = new TreeRecordPane();

const treeRouter = new TreeRouter({
    saveChangesTitle: "<%= I18n.t('save_changes_modal.save') %>"
});

if (!<%= read_only %>) {
  new TreeToolbar();
  new TreeToolbarActions();
  new TreeMultiSelection();
  new TreeDragDrop();
  new TreeCutPaste();
  new TreeMove();
  new TreeReorderActions();
}
</script>
