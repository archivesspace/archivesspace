<%
   section_id = "extents" if section_id.blank?
%>

<section id="<%= section_id %>" class="py-3">
  <h3><%= I18n.t("extent._plural") %></h3>
  <div class="details" id="<%= section_id %>_accordion">
    <% extents.each_with_index do | extent, index | %>
      <div class="card">
        <div class="panel-heading card-header">
          <%= render :layout => "shared/accordion_header_toggle",
                :locals => { :panel_id => "#{section_id}_extent_#{index}", :accordion_parent_id => "#{section_id}_accordion" } do %>
            <span class="accordion-header-toggle__cell--md-4">
              <%= extent['number'] %>
              <%= t('enumerations.extent_extent_type.'+extent['extent_type'], :default => extent['extent_type']) %>
            </span>
            <span class="accordion-header-toggle__cell--md-7">
              <%= extent['container_summary'] %>
            </span>
          <% end %>
        </div>
        <div id="<%= section_id %>_extent_<%= index %>" class="panel-collapse collapse">
          <%= read_only_view(extent) %>
        </div>
      </div>
    <% end %>
  </div>
</section>
