<%
  image_alt_text = thumbnail['caption']
  image_link_url = defined?(override_link_url) ? override_link_url : thumbnail_link_url(thumbnail)
  image_link_target = defined?(override_link_target) ? override_link_target : (thumbnail['record_uri'] ? '_self' : '_blank')
  # Link of the generic icon shown when the browser cannot display the image (ANW-3001)
  fallback_link_url = (thumbnail['image_url'] if image_link_url.nil? && FileURI.allowed_scheme?(thumbnail['image_url']))
  fallback_link_options = FileURI.download_only?(fallback_link_url) ? {:download => ''} : {:target => '_blank', :rel => 'noopener'}
  icon_class = "digital-object-thumbnail-icon #{thumbnail_icon_class(thumbnail['digital_object_type'])}"
  icon_label = strip_tags(image_alt_text.to_s)
  # In a search or browse table the thumbnail links to the row's own record, like the row's View
  # button, so it is hidden from screen readers and the keyboard to avoid a duplicate link
  duplicates_row_link = defined?(override_link_url) && override_link_url.present?
  show_fallback_icon = 'const parent = this.closest(".digital-object-thumbnail"); parent.querySelector("img").style.display = "none"; parent.querySelector(".digital-object-thumbnail-fallback").style.display = "block"; const fallbackLink = parent.querySelector(".digital-object-thumbnail-fallback-link"); if (fallbackLink) fallbackLink.style.display = "";'
%>
<div class="digital-object-thumbnail">
  <% image = capture do %>
    <% if thumbnail['image_url'] %>
      <%= image_tag thumbnail.fetch('image_url'), :alt => image_alt_text, 'onError' => show_fallback_icon %>
      <% fallback_icon = content_tag(:i, nil, {
        :title => image_alt_text,
        :class => "#{icon_class} digital-object-thumbnail-fallback",
        :style => 'display: none;',
        :role => 'img',
        'aria-label' => icon_label
      }) %>
      <% if fallback_link_url %>
        <%= link_to fallback_icon, fallback_link_url, fallback_link_options.merge(:class => 'digital-object-thumbnail-fallback-link', :style => 'display: none;') %>
      <% else %>
        <%= fallback_icon %>
      <% end %>
    <% else %>
      <%= content_tag(:i, nil, {
        :title => image_alt_text,
        :class => icon_class,
        :role => 'img',
        'aria-label' => icon_label
      }) %>
    <% end %>
  <% end %>
  <% link_options = {:target => image_link_target, :rel => ('noopener' if image_link_target == '_blank')} %>
  <% link_options.merge!('aria-hidden' => 'true', :tabindex => '-1') if duplicates_row_link %>
  <%= link_to_if image_link_url, image, image_link_url, link_options %>
  <% if (caption = thumbnail.fetch('caption', nil)) %>
    <div class="digital-object-thumbnail-caption">
      <%= strip_tags(caption) %>
    </div>
  <% end %>
</div>

<div class="clearfix"></div>
