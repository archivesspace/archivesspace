<%
  # In a search or browse table the thumbnail links to the row's own record, like the row's View
  # button, so it is hidden from screen readers and the keyboard to avoid a duplicate link
  duplicates_row_link = defined?(override_link_url) && override_link_url.present?
  # Only the browser can tell whether it can display an image, so when an image fails to load it tries
  # the next fallback image, and when none loads it shows the generic icon of the thumbnail (ANW-3089,
  # see thumbnail_fallback.js)
  candidates = thumbnail['image_url'] ? [thumbnail] + Array(thumbnail['fallbacks']) : [thumbnail]
%>
<div class="digital-object-thumbnail" data-image-timeout-seconds="<%= AppConfig[:thumbnail_image_timeout_seconds] %>">
  <% candidates.each_with_index do |candidate, index| %>
    <%
      image_alt_text = candidate['caption']
      image_link_url = defined?(override_link_url) ? override_link_url : thumbnail_link_url(candidate)
      image_link_target = defined?(override_link_target) ? override_link_target : (candidate['record_uri'] ? '_self' : '_blank')
      icon_class = "digital-object-thumbnail-icon #{thumbnail_icon_class(candidate['digital_object_type'])}"
      icon_label = strip_tags(image_alt_text.to_s)
    %>
    <%= content_tag(:div, :class => 'digital-object-thumbnail-candidate', :style => ('display: none;' unless index.zero?)) do %>
      <% image = capture do %>
        <% if (image_url = candidate['image_url']) && index.zero? %>
          <%= image_tag image_url, :alt => image_alt_text, 'onError' => 'showNextThumbnailCandidate(this)' %>
          <%# Shown in place of the images when the browser cannot load or display any of them %>
          <%= content_tag(:i, nil, {
            :title => image_alt_text,
            :class => "#{icon_class} digital-object-thumbnail-fallback",
            :style => 'display: none;',
            :role => 'img',
            'aria-label' => icon_label
          }) %>
        <% elsif image_url %>
          <%# Loaded only when the image before it fails %>
          <%= tag.img(:alt => image_alt_text, :data => {:src => image_url}, 'onError' => 'showNextThumbnailCandidate(this)') %>
        <% else %>
          <%= content_tag(:i, nil, {
            :title => image_alt_text,
            :class => icon_class,
            :role => 'img',
            'aria-label' => icon_label
          }) %>
        <% end %>
      <% end %>
      <% link_options = {:target => image_link_target} %>
      <% link_options.merge!('aria-hidden' => 'true', :tabindex => '-1') if duplicates_row_link %>
      <%= link_to_if image_link_url, image, image_link_url, link_options %>
      <% if (caption = candidate.fetch('caption', nil)) %>
        <div class="digital-object-thumbnail-caption">
          <%= strip_tags(caption) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>

<div class="clearfix"></div>
