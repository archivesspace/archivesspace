// Pre-fill metadata on a new DO by appending spawn_from_* to the instance linker Create
// data-target from the tree's current node before linker.js loads the form.

(function () {
  // digital_objects/_linker.html.erb may emit javascript_include_tag more than once per page,
  // so register the listener only once so we don't duplicate spawn_from_* query params on
  // repeated Create clicks.
  if (window.__digitalObjectSpawningInitialized) {
    return;
  }
  window.__digitalObjectSpawningInitialized = true;

  const SPAWN_TYPES = new Set(['resource', 'archival_object']);

  /**
   * @returns {{ type: string, id: string }|null}
   */
  function spawnPartsFromTree() {
    const container = document.querySelector('#tree-container');
    const { TreeIds } = window;
    if (!container || !TreeIds) {
      return null;
    }

    const node = container.querySelector(
      'li.node.current:not(.js-tree-synthetic-new)'
    );
    if (!node) {
      return null;
    }

    const uri = node.getAttribute('data-uri');
    let parts = uri ? TreeIds.uriToParts(uri) : null;
    if (!parts && node.id) {
      parts = TreeIds.parseTreeId(node.id);
    }

    if (!parts || !SPAWN_TYPES.has(parts.type)) {
      return null;
    }

    return parts;
  }

  /**
   * @param {string} target
   * @param {{ type: string, id: string }} parts
   * @returns {string}
   */
  function appendSpawnParam(target, parts) {
    if (!target || target.includes('spawn_from_')) {
      return target;
    }

    const separator = target.includes('?') ? '&' : '?';
    return `${target}${separator}spawn_from_${parts.type}_id=${encodeURIComponent(parts.id)}`;
  }

  document.addEventListener(
    'click',
    event => {
      const button = event.target.closest('.linker-create-btn');
      if (!button) {
        return;
      }

      const target = button.getAttribute('data-target');
      if (!target?.includes('/digital_objects/new')) {
        return;
      }

      const parts = spawnPartsFromTree();
      if (!parts) {
        return;
      }

      const updated = appendSpawnParam(target, parts);
      if (updated === target) {
        return;
      }

      button.setAttribute('data-target', updated);
      window.jQuery?.(button).data('target', updated);
    },
    true
  );
})();
