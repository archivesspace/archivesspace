# See http://help.github.com/ignore-files/ for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile ~/.gitignore_global

# Ignore bundler config
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3

# Ignore all logfiles and tempfiles.
/log/*.log
/tmp

/build/*.jar
/build/gems

/frontend.war

/public/assets

# IDE config folders
/.idea

# Legacy: LargeTree files the build used to copy into the public app (no longer
# copied as of ANW-3012). Kept so stale copies in existing checkouts stay
# untracked; safe to remove in a later release.
/vendor/assets/stylesheets/archivesspace/largetree.scss
/vendor/assets/javascripts/largetree.js.erb
