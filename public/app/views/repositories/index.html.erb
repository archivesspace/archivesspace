<div class="row">
  <div class="col-sm-9">
    <h1><%= @search_data['total_hits'] %> <%= (@search_data['total_hits'] == 1 ? t('repository._singular'): t('repository._plural')) %></h1>
    <%= render_pagination @pager, position: :top, nav_class: 'mb-3' %>
    <% @json.each do |result| %>
      <%= render partial: 'repositories/repository', locals: {:result => result, :full => false} %>
    <% end %>
    <%= render_pagination @pager, position: :bottom %>
  </div>
</div>
