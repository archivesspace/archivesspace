<ul>
  <% fvs.each do |fv| %>
    <%
      # ANW-1722 additional file version display rules
      caption = strip_mixed_content(fv['caption']) if fv['caption'].present?
      link_text =
        if caption.present?
          caption
        elsif fv['use_statement'].present?
          fv['use_statement']
        elsif fv['file_uri'].start_with?('data:')
          t('digital_object._public.url_encoded_data')
        else
          fv['file_uri']
        end
    %>
    <li data-additional-file-version>
      <% if FileURI.allowed_scheme?(fv['file_uri']) %>
        <%= link_to link_text, fv['file_uri'], target: 'new', title: t('digital_object._public.link') %>
      <% else %>
        <%= link_text %>
      <% end %>
    </li>
  <% end %>
</ul>
