<section id="navigation">
  <nav class="navbar navbar-expand-lg navbar-light navbar-default bg-light p-0" aria-label="<%= I18n.t("navigation.top_level") %>">
    <button type="button" class="navbar-toggler m-2 ms-auto" data-bs-toggle="collapse" data-bs-target="#collapsemenu" aria-expanded="false" aria-controls="collapsemenu">
      <div class="container">
        <span class="visually-hidden"><%= t('navigation.mobile_menu') %></span>
        <span class="navbar-toggler-icon"></span>
      </div>
    </button>

    <div class="collapse navbar-collapse top-bar px-4" id="collapsemenu">
      <ul class="navbar-nav me-auto">
        <%# TODO: add class="active" if we're on that page %>
        <% $MAIN_MENU.each do |link| %>
          <li class="nav-item p-2">
            <a class="nav-link" href="<%= app_prefix(link[0]) %>"><%= t(link[1]) %></a>
          </li>
        <% end %>

        <% unless AppConfig[:pui_hide][:search_tab] %>
          <li class="nav-item p-2">
            <a class="nav-link" href="<%= app_prefix('/search?reset=true') %>">
              <span class="fa fa-search" aria-hidden="true"></span>
              <span class="visually-hidden"><%= I18n.t('search_tab', :target => t('archive._plural')) %></span>
            </a>
          </li>
        <% end %>
      </ul>

      <% if AppConfig[:pui_require_authentication] %>
        <div class="dropdown user-container d-flex align-items-center pe-3">
          <button
            type="button"
            class="btn btn-outline-user-menu dropdown-toggle"
            id="user-menu-dropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <i class="fa fa-user" aria-hidden="true"></i>
            <span class="user-label"><%= session[:pui_username] %></span>
          </button>

          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="user-menu-dropdown">
            <li>
              <%= link_to t("login.logout"), {:controller => "sessions", :action => "logout"}, :id => "pui-logout", :class => "dropdown-item" %>
            </li>
          </ul>
        </div>
      <% end %>
    </div>
  </nav>
</section>
