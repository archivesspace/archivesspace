<%
  content_length = content.length
  max_chars = AppConfig[:pui_readmore_max_characters]
%>

<div class="wrap-anywhere note-content">
  <% unless is_inherited.blank? %>
    <%= inheritance(is_inherited).html_safe %>
  <% end %>

  <% if (calling_partial != 'record_innards' || content_length <= max_chars) %>
    <%= content.html_safe %>
  <% else %>
    <% readmore_uuid = SecureRandom.uuid %>
    <% readmore_id = "#{type}_readmore_#{readmore_uuid}" %>
    <% toggle_id = "#{readmore_id}_toggle" %>
    <% content_id = "#{readmore_id}_content" %>
    <div class="readmore position-relative mb-3 d-flex flex-column align-items-start">
      <button
        type="button"
        id="<%= toggle_id %>"
        class="readmore__toggle order-1"
        data-js="readmore-toggle"
        aria-expanded="false"
        aria-controls="<%= content_id %>"
      >
        <span class="readmore__text--more"><%= t('readmore.see_more') %> <i class="fa fa-chevron-down" aria-hidden="true"></i></span>
        <span class="readmore__text--less"><%= t('readmore.see_less') %> <i class="fa fa-chevron-up" aria-hidden="true"></i></span>
      </button>
      <section
        id="<%= content_id %>"
        class="readmore__content order-0"
      >
        <%= content.html_safe %>
      </section>
    </div>
  <% end %>
</div>
