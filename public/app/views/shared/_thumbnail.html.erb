<%
  n_digital_objects = nil unless defined?(n_digital_objects)
  # Lists (search results, the collection tree) pass the link of the result title
  title_link = thumbnail_link if defined?(thumbnail_link)
%>
<% if result.has_thumbnail? %>
  <%
    thumbnail = result.thumbnail
    # Only the browser can tell whether it can display an image, so when an image fails to load it tries
    # the next fallback image, and when none loads it shows the generic icon of the thumbnail (ANW-3089,
    # see thumbnail_fallback.js)
    candidates = thumbnail['image_url'] ? [thumbnail] + Array(thumbnail['fallbacks']) : [thumbnail]
  %>
  <div class="pui-thumbnail" data-image-timeout-seconds="<%= AppConfig[:thumbnail_image_timeout_seconds] %>">
    <% candidates.each_with_index do |candidate, index| %>
      <%
        caption = strip_mixed_content(candidate['caption'])

        # In a list, the thumbnail repeats the title link, so screen readers and the keyboard skip it.
        # Otherwise an accession, resource or archival object links to the digital object record, and a
        # digital object (component) opens its display link file version, if any, in a new window.
        if title_link.present?
          link_url = title_link
          link_options = {:target => '_self', 'aria-hidden' => 'true', :tabindex => '-1'}
          link_text = nil
        elsif candidate['record_uri']
          link_url = app_prefix(candidate['record_uri'])
          link_options = {:target => '_self'}
          link_text = t('thumbnails.view_digital_object')
        elsif FileURI.allowed_scheme?(candidate['link_url'])
          # The backend already drops a link_url whose scheme is not allowed; checking again here covers
          # records indexed before it did
          link_url = candidate['link_url']
          link_options = {:target => '_blank'}
          link_text = t('thumbnails.view_digital_material')
        else
          link_url = nil
        end

        icon_class = "pui-thumbnail-icon #{thumbnail_icon_class(candidate['digital_object_type'])}"
        icon_options = {:title => caption, :role => 'img', 'aria-label' => caption}
      %>
      <%= content_tag(:div, :class => 'pui-thumbnail-candidate', :style => ('display: none;' unless index.zero?)) do %>
        <% image = capture do %>
          <% if link_text %>
            <div class="pui-thumbnail-help-text"><%= link_text %></div>
          <% end %>
          <% if (image_url = candidate['image_url']) && index.zero? %>
            <%= image_tag image_url, :alt => caption, 'onError' => 'showNextThumbnailCandidate(this)' %>
            <%# Shown in place of the images when the browser cannot load or display any of them %>
            <%= content_tag(:i, nil, icon_options.merge(:class => "#{icon_class} pui-thumbnail-fallback", :style => 'display: none;')) %>
          <% elsif image_url %>
            <%# Loaded only when the image before it fails %>
            <%= tag.img(:alt => caption, :data => {:src => image_url}, 'onError' => 'showNextThumbnailCandidate(this)') %>
          <% else %>
            <%= content_tag(:i, nil, icon_options.merge(:class => icon_class)) %>
          <% end %>
        <% end %>
        <%= link_to_if link_url, image, link_url, link_options %>
        <% if caption.present? %>
          <div class="pui-thumbnail-caption"><%= caption %></div>
        <% end %>
      <% end %>
    <% end %>
    <% if n_digital_objects && representative_link_to_digital_materials?(result) %>
      <div class="pui-thumbnail-digital-materials">
        <%= link_to t('digital_object._public.browse_number_digital_objects_in_collection', num: n_digital_objects, count: n_digital_objects),
                    app_prefix("#{result.uri}/digitized"),
                    data: { 'view-all-digital-objects' => true } %>
      </div>
    <% end %>
  </div>
<% end %>
