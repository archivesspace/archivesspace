<%#
  Record show-page hierarchy sidebar (resources, archival objects, digital
  objects, digital object components, classifications, classification terms).

  Locals: heading_text, root_node_uri, current_node_uri
%>
<h2><%= heading_text %></h2>
<%= render partial: 'shared/infinite_tree_record_container', locals: {
  id: 'record-tree-container',
  root_uri: root_node_uri,
  current_uri: current_node_uri
} %>
<%= infinite_tree_templates %>

<script>
  InfiniteTree.fromRecordContainer(
    document.querySelector('#record-tree-container')
  );
</script>
